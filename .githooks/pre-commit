#!/usr/bin/env bash
# fire pre-commit: refuse to commit anything that looks like a secret or private infrastructure detail.
# Scans ADDED lines of staged files. No bypass flag on purpose; fix the content.
set -euo pipefail
added="$(git diff --cached -U0 --no-color | grep -E '^\+' | grep -Ev '^\+\+\+' || true)"
[ -n "$added" ] || exit 0
pat='(ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{60,}|gho_[A-Za-z0-9]{36}|xox[baprs]-[A-Za-z0-9-]{10,}|tskey-[A-Za-z0-9-]{10,}|AKIA[0-9A-Z]{16}|ops_eyJ[A-Za-z0-9_.-]{20,}|sk-[A-Za-z0-9]{32,}|sk-ant-[A-Za-z0-9_-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|eyJ[A-Za-z0-9_-]{20,}\.eyJ[A-Za-z0-9_-]{20,}|[0-9]{8,10}:AA[A-Za-z0-9_-]{30,}|\b10\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\b|\b192\.168\.[0-9]{1,3}\.[0-9]{1,3}\b|\b100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.[0-9]{1,3}\.[0-9]{1,3}\b|malstrom\.org|doofus\.co|[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[a-z]{2,})'
hits="$(printf '%s\n' "$added" | grep -En "$pat" || true)"
if command -v gitleaks >/dev/null 2>&1; then gitleaks protect --staged --redact >/dev/null 2>&1 || hits="${hits}"$'\n'"gitleaks: findings (run: gitleaks protect --staged)"; fi
if [ -n "$hits" ]; then
  echo "✗ pre-commit: refusing — staged content looks like a secret, a private IP, a lab domain or an email:" >&2
  printf '%s\n' "$hits" | sed 's/^/    /' | cut -c1-160 >&2
  echo "  Remove it (or move it to 1Password / an ignored file) and commit again. There is no bypass flag." >&2
  exit 1
fi
